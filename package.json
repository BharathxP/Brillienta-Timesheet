{
  "name": "brillienta-timesheet",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "scripts": {
    "build": "heft build --clean --production && heft package-solution --production",
    "build:dev": "heft build --clean",
    "test": "heft build --clean && node --test tests/*.test.cjs",
    "test:only": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "heft clean",
    "start": "heft start --clean",
    "serve": "heft start --clean",
    "preview": "heft build --clean && node preview/build.cjs",
    "license": "node tools/license/license.cjs"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-http": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2",
    "@microsoft/sp-page-context": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "javascript-obfuscator": "^5.8.1",
    "typescript": "~5.8.0",
    "webpack-obfuscator": "^3.6.1"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  },
  "resolutions": {
    "@types/react": "17.0.45"
  }
